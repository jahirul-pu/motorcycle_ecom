# -------------------------

logs/

*.log

npm-debug.log*

pnpm-debug.log*

yarn-debug.log*

yarn-error.log*

# -------------------------
# Environment
# -------------------------

.env

.env.local

.env.development.local

.env.production.local

.env.test.local

!.env.example

# -------------------------
# Prisma
# -------------------------

prisma/dev.db

prisma/dev.db-journal

# -------------------------
# Docker
# -------------------------

docker-data/

# -------------------------
# Redis
# -------------------------

dump.rdb

# -------------------------
# Uploads
# -------------------------

uploads/

storage/

media/

# -------------------------
# Temporary Files
# -------------------------

tmp/

temp/

*.tmp

*.temp

# -------------------------
# IDE
# -------------------------

.vscode/

.idea/

*.iml

# -------------------------
# Operating System
# -------------------------

.DS_Store

Thumbs.db

Desktop.ini

# -------------------------
# Testing
# -------------------------

playwright-report/

test-results/

coverage/

.nyc_output/

# -------------------------
# TypeScript
# -------------------------

*.tsbuildinfo

# -------------------------
# ESLint
# -------------------------

.eslintcache

# -------------------------
# Miscellaneous
# -------------------------

*.pid

*.seed

*.orig

*.rej

*.bak

# -------------------------
# Package Managers
# -------------------------

package-lock.json

yarn.lock

# pnpm is the official package manager
# Keep pnpm-lock.yaml

# -------------------------
# Generated Files
# -------------------------

generated/

generated-types/

# -------------------------
# Local Configuration
# -------------------------

.envrc

.direnv/

# -------------------------
# Certificates
# -------------------------

*.pem

*.key

*.crt

*.p12

# -------------------------
# Backup Files
# -------------------------

backup/

backups/

*.backup

*.zip

*.tar

*.gz

# -------------------------
# Database Dumps
# -------------------------

*.sql

*.sqlite

*.sqlite3

# -------------------------
# Editor History
# -------------------------

.history/

# -------------------------
# Sentry
# -------------------------

.sentryclirc

# -------------------------
# Terraform (Future)
# -------------------------

.terraform/

terraform.tfstate

terraform.tfstate.*

# -------------------------
# Coolify
# -------------------------

.coolify/

